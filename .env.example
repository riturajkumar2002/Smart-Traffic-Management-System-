# Smart Traffic Management System - Environment Variables

# YOLO Model Configuration
YOLO_MODEL_PATH=yolov8n.pt
CONF_THRESHOLD=0.3
MAX_TRACK_AGE=30
SMOOTHING_WINDOW=10

# Video Source (Local file, RTSP URL like rtsp://admin:pass@192.168.1.100:554/stream1, or webcam index 0)
VIDEO_SOURCE=video/traffic.mp4

# MySQL Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=newpassword123
DB_NAME=traffic_management
DB_POOL_SIZE=5

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
